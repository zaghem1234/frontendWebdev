# Verdant Oasis — Environment Variable Template
# 
# INSTRUCTIONS:
#   1. Copy this file and rename it to `.env.local`
#   2. Fill in your actual Supabase credentials from:
#      https://supabase.com/dashboard/project/<your-project>/settings/api
#   3. NEVER commit .env.local to Git. It is protected by .gitignore.
#

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here
